// This schema uses Discord IDs for authentication instead of standard email/password fields.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Core User and Authentication Models ---

enum Role {
  ADMIN
  ORGANIZER
  USER
}

model User {
  id          String   @id @default(uuid())
  discordId   String   @unique
  username    String?
  avatarUrl   String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isBanned    Boolean  @default(false)
  banReason   String?
  bannedUntil DateTime?

  teams                    TeamMember[]
  tournamentParticipants   TournamentParticipant[]
  notifications            Notification[]
}

// --- Team Management Models ---

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  captainId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  captain  User         @relation(fields: [captainId], references: [id])
  members  TeamMember[]
}

model TeamMember {
  id       String @id @default(uuid())
  userId   String
  teamId   String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

// --- Tournament Models ---

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  LEAGUE
}

enum TournamentState {
  DRAFT
  OPEN
  RUNNING
  FINISHED
}

model Tournament {
  id            String            @id @default(uuid())
  name          String
  description   String?
  game          String
  startDate     DateTime?
  maxTeams      Int
  format        TournamentFormat
  status        TournamentState   @default(DRAFT)
  organizerId   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  organizer     User                    @relation(fields: [organizerId], references: [id])
  participants  TournamentParticipant[]
  matches       Match[]
  rankings      Ranking[]
}

model TournamentParticipant {
  id            String   @id @default(uuid())
  tournamentId  String
  userId        String
  isTeam        Boolean  @default(false)
  status        String   @default("PENDING_APPROVAL")

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

// --- Match and Ranking Models ---

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  PENDING
  COMPLETED
  CANCELLED
}

model Match {
  id                    String      @id @default(uuid())
  tournamentId          String
  matchUuid             String      @unique
  status                MatchStatus @default(PENDING)
  scheduledDate         DateTime?
  winningParticipantId  String?
  teamAId               String
  teamBId               String
  matchDay              Int
  roundName             String?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  teamA      Team       @relation("TeamAMatches", fields: [teamAId], references: [id])
  teamB      Team       @relation("TeamBMatches", fields: [teamBId], references: [id])
}

model Ranking {
  id            String @id @default(uuid())
  tournamentId  String
  entityName    String
  entityType    String
  score         Int    @default(0)
  wins          Int    @default(0)
  losses        Int    @default(0)
  gamesPlayed   Int    @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id])
}

// --- Utility Models ---

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
