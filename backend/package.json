# backend/package.json
{
  "name": "tournamenthub-backend",
  "version": "1.0.0",
  "description": "REST API for TournamentHub core logic.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npx ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "npx tsc --noEmit"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.x.x",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.19.2",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.0.2",
    "ts-node": "^20.12.2", 
    "nodemon": "^3.1.0"
  }
}